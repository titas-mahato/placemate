# Copy to backend/.env and fill in. NEVER commit the real .env file.
APP_ENV=development            # development | production
SECRET_KEY=                    # required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"

DB_HOST=localhost
DB_PORT=3306
DB_USER=sau_app                # use a dedicated MySQL user, not root
DB_PASSWORD=change-me
DB_NAME=placement_and_internship_cell

# Comma-separated browser origins allowed to call the API cross-site. Leave empty when the
# frontend is served from the same origin (Vite dev proxy / reverse proxy in production).
CORS_ORIGINS=
SESSION_COOKIE_SECURE=false    # must be true behind HTTPS (defaults to true in production)
SESSION_HOURS=8
UPLOAD_DIR=                    # default: backend/uploads (keep outside the web root)
