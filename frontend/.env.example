# Frontend (Vite). Copy to .env.local if you need to change anything — the defaults work for local development.
# Leave VITE_API_URL empty so the browser calls the API on its own origin (/api/...). In development Vite proxies
# /api to the Flask server; in production put both behind one reverse proxy (see docs/architecture.md).
VITE_API_URL=
# Where the dev server forwards /api requests (development only).
VITE_API_PROXY=http://127.0.0.1:5000
